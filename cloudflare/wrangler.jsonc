{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinellayer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "persist": true, "invocation_logs": true },
    "head_sampling_rate": 1
  },
  "containers": [
    {
      "class_name": "SentinelLayerContainer",
      "image": "../Dockerfile",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SENTINELLAYER_CONTAINER",
        "class_name": "SentinelLayerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SentinelLayerContainer"]
    }
  ]
}
