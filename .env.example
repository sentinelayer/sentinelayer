# Required
DATABASE_URL=postgresql://user:pass@host:5432/db
JWT_SECRET=your-jwt-secret-change-me
POLICY_SIGNING_SECRET=your-policy-secret-change-me
TELEMETRY_KEY=your-telemetry-key-change-me

# Optional
ENVIRONMENT=production
ALLOWED_ORIGINS=https://yourdomain.com
THREAT_INTEL_PROVIDER=virustotal
VIRUSTOTAL_API_KEY=your-api-key
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o-mini
LLM_FAIL_OPEN=false
MFA_ISSUER=SentinelLayer
RATE_LIMIT=60
BREAK_GLASS_DURATION_HOURS=1
EXTERNAL_REVIEWER_EMAIL=reviewer@sentinelayer.com
