DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelayer
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_URL=redis://localhost:6379/0
REDIS_ADDR=localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
METRICS_TOKEN=replace-with-a-random-scrape-token
WEBHOOK_SECRET=replace-with-at-least-16-random-characters
# Production must use a durable secret-manager/KMS key; never commit the value.
KMS_KEY=replace-with-fernet-or-kms-managed-key
WEBHOOK_DELIVERY_MAX_ATTEMPTS=5
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=5
SL_ENV=development
UPSTREAM_URL=http://localhost:8005
RISK_ENGINE_URL=http://localhost:8090
SL_ENFORCE_PROVENANCE=false
SL_APPROVED_ARTIFACT_HASH=
SL_RUNNING_ARTIFACT_HASH=
CONTROL_PLANE_URL=http://localhost:8005
WORKER_INTERVAL_SECONDS=300
WORKER_LOCK_PATH=/tmp/sentinelayer-maintenance.lock
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
# Optional: set a secret-manager-backed GPG recipient for encrypted database dumps.
GPG_RECIPIENT=

# Production: use three provisioned service roles; keep migration credentials in a separate job.
AUTH_DATABASE_URL=
WORKER_DATABASE_URL=
# Set to 0 in production; development defaults to 1.
SL_RUN_STARTUP_MIGRATION=
# Optional single-tenant gateway policy binding. Set all four together.
# Public keys must be pinned through trusted deployment configuration.
GATEWAY_POLICY_URL=
GATEWAY_POLICY_API_KEY=
GATEWAY_POLICY_ID=
GATEWAY_POLICY_TENANT_ID=

# Alternative: explicit host-to-tenant bindings; do not mix with the four values above.
GATEWAY_POLICY_BINDINGS_JSON=
# Optional gateway receipts; set both values and register the service account first.
GATEWAY_INSTANCE_ID=
GATEWAY_POLICY_ACK_URL=
# Optional durable version floor. Mount a private persistent volume for one gateway process.
GATEWAY_POLICY_STATE_DIR=
